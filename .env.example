# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and holds all secrets/credentials.

# Django settings
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# AI provider (Gemini for now; Ollama later)
GEMINI_API_KEY=

# PostgreSQL database
POSTGRES_DB=cyber_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5545
